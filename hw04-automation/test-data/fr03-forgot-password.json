{
  "feature": "FR-03",
  "featureName": "Forgot password and password reset (two steps)",
  "source": "EShop README FR-03 + FR-01 password rules + FR-22 form rules; HW02 Feature A; HW04 Task 1",
  "cases": [
    {
      "id": "TC-FORGOT-001",
      "category": "positive",
      "purpose": "Registered user completes both forgot-password steps and can log in with the new password",
      "preconditions": "Unique registered account created via API before the test",
      "setup": { "createUser": true },
      "journey": "fullReset",
      "inputs": {
        "emailMode": "registered",
        "otpMode": "fromScreen",
        "newPassword": "NewPass1 ",
        "passwordNote": "SUT client regex treats whitespace as the required 'special' character"
      },
      "expected": {
        "assertions": [
          { "type": "dialog", "value": "Đổi mật khẩu thành công!" },
          { "type": "url", "pattern": "/login" },
          { "type": "apiLogin", "passwordSource": "new", "status": 200 }
        ]
      }
    },
    {
      "id": "TC-FORGOT-002",
      "category": "negative",
      "purpose": "Empty email must not advance to OTP step",
      "preconditions": "None",
      "setup": { "createUser": false },
      "journey": "requestOnly",
      "inputs": {
        "emailMode": "empty"
      },
      "expected": {
        "assertions": [
          { "type": "visible", "target": "heading" },
          { "type": "visible", "target": "requestOtpButton" },
          { "type": "hidden", "target": "otpMessage" },
          { "type": "hidden", "target": "resetButton" }
        ]
      }
    },
    {
      "id": "TC-FORGOT-003",
      "category": "negative",
      "purpose": "Invalid email format is rejected at request step",
      "preconditions": "None",
      "setup": { "createUser": false },
      "journey": "requestOnly",
      "inputs": {
        "emailMode": "custom",
        "customEmail": "not-an-email"
      },
      "expected": {
        "assertions": [
          { "type": "dialogMatches", "pattern": "Lỗi:" },
          { "type": "visible", "target": "requestOtpButton" },
          { "type": "hidden", "target": "resetButton" }
        ]
      }
    },
    {
      "id": "TC-FORGOT-004",
      "category": "negative",
      "purpose": "Unregistered email cannot obtain an OTP",
      "preconditions": "Email is not present in the user table",
      "setup": { "createUser": false },
      "journey": "requestOnly",
      "inputs": {
        "emailMode": "unregistered"
      },
      "expected": {
        "assertions": [
          { "type": "dialogMatches", "pattern": "User not found|Lỗi:" },
          { "type": "visible", "target": "requestOtpButton" },
          { "type": "hidden", "target": "resetButton" }
        ]
      }
    },
    {
      "id": "TC-FORGOT-005",
      "category": "negative",
      "purpose": "Wrong OTP value is rejected at reset step",
      "preconditions": "Registered account; valid OTP issued on screen",
      "setup": { "createUser": true },
      "journey": "fullReset",
      "inputs": {
        "emailMode": "registered",
        "otpMode": "custom",
        "customOtp": "0000",
        "newPassword": "NewPass1 "
      },
      "expected": {
        "assertions": [
          { "type": "containText", "target": "otpMessage", "value": "Mã OTP của bạn là:" },
          { "type": "attribute", "target": "newPasswordInput", "name": "type", "value": "password" },
          { "type": "dialogMatches", "pattern": "Mã OTP không đúng|lỗi" },
          { "type": "url", "pattern": "/forgot-password" },
          { "type": "apiLogin", "passwordSource": "initial", "status": 200 }
        ]
      }
    },
    {
      "id": "TC-FORGOT-006",
      "category": "negative",
      "purpose": "Empty OTP must not complete password reset",
      "preconditions": "Registered account; OTP step reached",
      "setup": { "createUser": true },
      "journey": "fullReset",
      "inputs": {
        "emailMode": "registered",
        "otpMode": "empty",
        "newPassword": "NewPass1 "
      },
      "expected": {
        "assertions": [
          { "type": "visible", "target": "resetButton" },
          { "type": "url", "pattern": "/forgot-password" },
          { "type": "apiLogin", "passwordSource": "initial", "status": 200 }
        ]
      }
    },
    {
      "id": "TC-FORGOT-007",
      "category": "boundary",
      "purpose": "OTP with incorrect length (5 digits) is rejected",
      "preconditions": "Registered account; OTP step reached",
      "setup": { "createUser": true },
      "journey": "fullReset",
      "inputs": {
        "emailMode": "registered",
        "otpMode": "custom",
        "customOtp": "12345",
        "newPassword": "NewPass1 "
      },
      "expected": {
        "assertions": [
          { "type": "dialogMatches", "pattern": "Mã OTP không đúng|lỗi|yếu" },
          { "type": "url", "pattern": "/forgot-password" },
          { "type": "apiLogin", "passwordSource": "initial", "status": 200 }
        ]
      }
    },
    {
      "id": "TC-FORGOT-008",
      "category": "negative",
      "purpose": "New password shorter than 8 characters is rejected (FR-01)",
      "preconditions": "Registered account; valid OTP on screen",
      "setup": { "createUser": true },
      "journey": "fullReset",
      "inputs": {
        "emailMode": "registered",
        "otpMode": "fromScreen",
        "newPassword": "Ab1 "
      },
      "expected": {
        "assertions": [
          { "type": "dialogMatches", "pattern": "Mật khẩu quá yếu|yếu" },
          { "type": "url", "pattern": "/forgot-password" },
          { "type": "apiLogin", "passwordSource": "initial", "status": 200 }
        ]
      }
    },
    {
      "id": "TC-FORGOT-009",
      "category": "negative",
      "purpose": "New password missing uppercase letter is rejected (FR-01)",
      "preconditions": "Registered account; valid OTP on screen",
      "setup": { "createUser": true },
      "journey": "fullReset",
      "inputs": {
        "emailMode": "registered",
        "otpMode": "fromScreen",
        "newPassword": "newpass1 "
      },
      "expected": {
        "assertions": [
          { "type": "dialogMatches", "pattern": "Mật khẩu quá yếu|yếu" },
          { "type": "url", "pattern": "/forgot-password" },
          { "type": "apiLogin", "passwordSource": "initial", "status": 200 }
        ]
      }
    },
    {
      "id": "TC-FORGOT-010",
      "category": "validation",
      "purpose": "Step 2 must provide a confirm-password field matching FR-03",
      "preconditions": "Registered account; OTP requested",
      "setup": { "createUser": true },
      "journey": "requestThenInspect",
      "inputs": {
        "emailMode": "registered"
      },
      "expected": {
        "assertions": [
          { "type": "containText", "target": "otpMessage", "value": "Mã OTP của bạn là:" },
          { "type": "visible", "target": "confirmPasswordInput" },
          { "type": "attribute", "target": "confirmPasswordInput", "name": "type", "value": "password" }
        ]
      }
    },
    {
      "id": "TC-FORGOT-011",
      "category": "ui",
      "purpose": "Forgot-password page shows a two-step indicator (FR-03 / FR-22)",
      "preconditions": "None",
      "setup": { "createUser": false },
      "journey": "uiContract",
      "inputs": {},
      "expected": {
        "assertions": [
          { "type": "visible", "target": "heading" },
          { "type": "visible", "target": "stepIndicator" },
          { "type": "containText", "target": "stepIndicator", "value": "Bước 1" }
        ]
      }
    },
    {
      "id": "TC-FORGOT-012",
      "category": "ui",
      "purpose": "Quay lại đăng nhập control returns the user to the login page",
      "preconditions": "None",
      "setup": { "createUser": false },
      "journey": "backToLogin",
      "inputs": {},
      "expected": {
        "assertions": [
          { "type": "visible", "target": "backToLogin" },
          { "type": "url", "pattern": "/login" }
        ]
      }
    },
    {
      "id": "TC-FORGOT-013",
      "category": "validation",
      "purpose": "Email field uses type=email for HTML5 format validation (FR-22)",
      "preconditions": "None",
      "setup": { "createUser": false },
      "journey": "uiContract",
      "inputs": {},
      "expected": {
        "assertions": [
          { "type": "visible", "target": "emailInput" },
          { "type": "attribute", "target": "emailInput", "name": "type", "value": "email" }
        ]
      }
    },
    {
      "id": "TC-FORGOT-014",
      "category": "boundary",
      "purpose": "Demo OTP shown after step 1 must be exactly 6 digits (FR-03 / SEC-07)",
      "preconditions": "Registered account",
      "setup": { "createUser": true },
      "journey": "requestThenInspect",
      "inputs": {
        "emailMode": "registered"
      },
      "expected": {
        "assertions": [
          { "type": "containText", "target": "otpMessage", "value": "Mã OTP của bạn là:" },
          { "type": "otpLength", "value": 6 }
        ]
      }
    }
  ]
}
