{
  "info": {
    "name": "Mini Exercise - GET /api/cart",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /api/cart - data driven",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tokenMode = pm.iterationData.get('token_mode');",
              "const baseUrl = pm.environment.get('base_url');",
              "const studentId = pm.environment.get('student_id');",
              "",
              "pm.request.headers.upsert({ key: 'X-Student-Id', value: studentId });",
              "pm.request.headers.remove('Authorization');",
              "",
              "function setAuthHeader(token) {",
              "  pm.environment.set('auth_token', token);",
              "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
              "}",
              "",
              "if (tokenMode === 'missing') {",
              "  pm.environment.unset('auth_token');",
              "} else if (tokenMode === 'invalid') {",
              "  setAuthHeader('invalid-token');",
              "} else if (tokenMode === 'malformed') {",
              "  setAuthHeader('not.a.valid.jwt');",
              "} else {",
              "  pm.sendRequest({",
              "    url: baseUrl + '/api/login',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: {",
              "      mode: 'raw',",
              "      raw: JSON.stringify({ email: 'test@eshop.com', password: 'Test1234!' })",
              "    }",
              "  }, function (loginErr, loginRes) {",
              "    if (loginErr) { throw loginErr; }",
              "    const token = loginRes.json().token;",
              "    setAuthHeader(token);",
              "",
              "    if (pm.iterationData.get('setup_cart') === true || pm.iterationData.get('setup_cart') === 'true') {",
              "      pm.sendRequest({",
              "        url: baseUrl + '/api/cart',",
              "        method: 'POST',",
              "        header: {",
              "          'Content-Type': 'application/json',",
              "          'Authorization': 'Bearer ' + token,",
              "          'X-Student-Id': studentId",
              "        },",
              "        body: {",
              "          mode: 'raw',",
              "          raw: JSON.stringify({",
              "            id: Number(pm.iterationData.get('setup_item_id')),",
              "            name: pm.iterationData.get('setup_item_name'),",
              "            price: Number(pm.iterationData.get('setup_item_price')),",
              "            quantity: Number(pm.iterationData.get('setup_item_quantity'))",
              "          })",
              "        }",
              "      }, function (setupErr) {",
              "        if (setupErr) { throw setupErr; }",
              "      });",
              "    }",
              "  });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const caseId = pm.iterationData.get('case_id');",
              "const expectedStatus = Number(pm.iterationData.get('expected_status'));",
              "const expectedIsArray = pm.iterationData.get('expected_is_array') === true || pm.iterationData.get('expected_is_array') === 'true';",
              "const expectError = pm.iterationData.get('expect_error') === true || pm.iterationData.get('expect_error') === 'true';",
              "const expectedMinItems = Number(pm.iterationData.get('expected_min_items') || 0);",
              "const maxResponseMs = Number(pm.iterationData.get('max_response_ms') || 1000);",
              "",
              "pm.test(caseId + ' - status code is expected', function () {",
              "  pm.response.to.have.status(expectedStatus);",
              "});",
              "",
              "pm.test(caseId + ' - Content-Type is JSON', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test(caseId + ' - response time is acceptable', function () {",
              "  pm.expect(pm.response.responseTime).to.be.below(maxResponseMs);",
              "});",
              "",
              "pm.test(caseId + ' - X-Student-Id header was attached', function () {",
              "  pm.expect(pm.request.headers.get('X-Student-Id')).to.eql(pm.environment.get('student_id'));",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "if (expectedIsArray) {",
              "  pm.test(caseId + ' - response body is an array', function () {",
              "    pm.expect(body).to.be.an('array');",
              "  });",
              "",
              "  pm.test(caseId + ' - response has expected minimum cart items', function () {",
              "    pm.expect(body.length).to.be.at.least(expectedMinItems);",
              "  });",
              "",
              "  if (expectedMinItems > 0) {",
              "    pm.test(caseId + ' - cart item schema is valid', function () {",
              "      pm.expect(body[0]).to.have.property('id');",
              "      pm.expect(body[0]).to.have.property('name');",
              "      pm.expect(body[0]).to.have.property('price');",
              "      pm.expect(body[0]).to.have.property('quantity');",
              "    });",
              "  }",
              "} else if (expectError) {",
              "  pm.test(caseId + ' - error body contains error field', function () {",
              "    pm.expect(body).to.be.an('object');",
              "    pm.expect(body).to.have.property('error');",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Student-Id",
            "value": "{{student_id}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/cart",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "cart"
          ]
        }
      },
      "response": []
    }
  ]
}
