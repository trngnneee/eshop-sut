            "api",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Nguyen Van A\",\"email\":\"dp01@hw6.com\",\"password\":\"Password123!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-A-DP-01: Status 200', function() { pm.response.to.have.status(200); });",
              "pm.test('TC-A-DP-01: message is string', function() { pm.expect(pm.response.json().message).to.be.a('string'); });",
              "pm.test('TC-A-DP-01: id is number', function() { pm.expect(pm.response.json().id).to.be.a('number'); });",
              "pm.test('TC-A-DP-01: No password in response', function() { pm.expect(pm.response.json()).to.not.have.property('password'); });"
            ]
          }
        }
