{
  "info": {
    "name": "Debug Test",
    "_postman_id": "debug-test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Test POST Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"name\":\"TestUser\",\"email\":\"debug@test.com\",\"password\":\"Pass123!\"}" },
        "url": {
          "raw": "http://localhost:3000/api/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "register"]
        }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200 or 400', function() { pm.expect(pm.response.code).to.be.oneOf([200, 400]); });"
      ]}}]
    }
  ]
}
