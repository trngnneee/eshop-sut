{
  "info": {
    "_postman_id": "b2c3d4e5-dd02-4000-8000-000000000002",
    "name": "HW06 – Data-Driven API 2 (GET /api/orders/my-orders)",
    "description": "Data-Driven Test Suite for FR-11 Order History View using iteration data JSON",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "SETUP Login regular user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"test@eshop.com\",\"password\":\"Test1234!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var j = pm.response.json();",
              "    if (j.token) pm.environment.set('token', j.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "SETUP Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@eshop.com\",\"password\":\"Admin123!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var j = pm.response.json();",
              "    if (j.token) pm.environment.set('adminToken', j.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /api/orders/my-orders [Data-Driven Runner]",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var tc_id = pm.iterationData.get('tc_id') || 'TC-B-DD';",
              "var desc = pm.iterationData.get('description') || '';",
              "var auth_type = pm.iterationData.get('auth_type');",
              "var query_params = pm.iterationData.get('query_params') || '';",
              "",
              "pm.request.headers.upsert({",
              "  key: 'X-Student-Id',",
              "  value: pm.environment.get('studentId') || '23127486'",
              "});",
              "",
              "// Apply auth header based on auth_type",
              "if (auth_type === 'VALID_USER') {",
              "    var uToken = pm.environment.get('token');",
              "    if (uToken) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + uToken });",
              "} else if (auth_type === 'VALID_ADMIN') {",
              "    var aToken = pm.environment.get('adminToken');",
              "    if (aToken) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + aToken });",
              "} else if (auth_type === 'NO_AUTH') {",
              "    pm.request.headers.remove('Authorization');",
              "} else if (auth_type === 'NO_BEARER_PREFIX') {",
              "    pm.request.headers.upsert({ key: 'Authorization', value: pm.environment.get('token') || 'valid_token_raw' });",
              "} else if (auth_type === 'EMPTY_BEARER') {",
              "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' });",
              "} else if (auth_type === 'FORGED_JWT') {",
              "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.t-IDcSemACt8x4iTMCda8Yhe3iZaWbvV5XKSTbuAn0M_forged' });",
              "} else if (auth_type === 'EXPIRED_JWT') {",
              "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE1MTYyMzkwMjJ9.expired' });",
              "} else if (auth_type === 'ALG_NONE_JWT') {",
              "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJ1c2VySWQiOjEsImVtYWlsIjoidXNlckBlc2hvcC5jb20ifQ.' });",
              "} else if (auth_type === 'BASIC_AUTH') {",
              "    pm.request.headers.upsert({ key: 'Authorization', value: 'Basic dXNlckBlc2hvcC5jb206UGFzc3dvcmQxMjMh' });",
              "} else if (auth_type === 'LOWERCASE_BEARER') {",
              "    pm.request.headers.upsert({ key: 'Authorization', value: 'bearer ' + (pm.environment.get('token') || '') });",
              "}",
              "",
              "pm.variables.set('query_str', query_params);",
              "console.log('[DD API2] Running ' + tc_id + ': ' + desc);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var tc_id = pm.iterationData.get('tc_id') || 'TC-B-DD';",
              "var desc = pm.iterationData.get('description') || '';",
              "var expected_status = pm.iterationData.get('expected_status') || 200;",
              "var expect_array = pm.iterationData.get('expect_array');",
              "",
              "pm.test('[' + tc_id + '] ' + desc + ' -> Status is ' + expected_status, function () {",
              "    pm.response.to.have.status(expected_status);",
              "});",
              "",
              "pm.test('[' + tc_id + '] Response Content-Type is JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "if (expected_status === 200 && expect_array) {",
              "    pm.test('[' + tc_id + '] Response is Array of Orders', function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(Array.isArray(jsonData)).to.be.true;",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/my-orders{{query_str}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "my-orders"
          ]
        }
      },
      "response": []
    }
  ]
}
