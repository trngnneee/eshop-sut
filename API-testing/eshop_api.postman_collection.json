{
  "info": {
    "name": "EShop API Data-driven Test Suite",
    "description": "Single-runner Postman collection that reads each test case from API-testing/data/test-data.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const configuredStudentId = pm.variables.get(\"studentId\");",
          "const studentId = configuredStudentId && configuredStudentId !== \"PUT_YOUR_STUDENT_ID_HERE\"",
          "  ? configuredStudentId",
          "  : \"23127158\";",
          "pm.collectionVariables.set(\"studentId\", studentId);",
          "pm.request.headers.upsert({ key: \"X-Student-Id\", value: studentId });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Data-driven Runner",
      "item": [
        {
          "name": "Run test case from iteration data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{requestBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{requestUrl}}",
              "host": [
                "{{requestUrl}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const record = pm.iterationData.toObject();",
                  "const method = String(record.method || \"GET\").toUpperCase();",
                  "const path = record.path || \"/\";",
                  "",
                  "const baseUrl = String(pm.variables.get(\"baseUrl\") || \"\").replace(/\\/+$/, \"\");",
                  "const requestUrl = `${baseUrl}/${String(path).replace(/^\\/+/, \"\")}`;",
                  "pm.collectionVariables.set(\"requestUrl\", requestUrl);",
                  "",
                  "pm.collectionVariables.set(\"requestMethod\", method);",
                  "pm.collectionVariables.set(\"requestPath\", path);",
                  "pm.request.url = requestUrl;",
                  "pm.request.method = method;",
                  "",
                  "const body = record.body === undefined || record.body === null ? {} : record.body;",
                  "pm.collectionVariables.set(\"requestBody\", typeof body === \"string\" ? body : JSON.stringify(body));",
                  "",
                  "let headers = record.headers || {};",
                  "if (typeof headers === \"string\" && headers.trim()) {",
                  "  headers = JSON.parse(headers);",
                  "}",
                  "",
                  "function loginAndStore(email, password, variableName, next) {",
                  "  const current = pm.collectionVariables.get(variableName);",
                  "  if (current) return next();",
                  "",
                  "  pm.sendRequest({",
                  "    url: `${baseUrl}/api/login`,",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "      mode: \"raw\",",
                  "      raw: JSON.stringify({ email, password })",
                  "    }",
                  "  }, function (err, res) {",
                  "    pm.expect(err, `${variableName} login request error`).to.equal(null);",
                  "    pm.expect(res.code, `${variableName} login status`).to.equal(200);",
                  "    const json = res.json();",
                  "    pm.expect(json.token, `${variableName} token`).to.be.a(\"string\").and.not.empty;",
                  "    pm.collectionVariables.set(variableName, json.token);",
                  "    next();",
                  "  });",
                  "}",
                  "",
                  "function applyHeaders() {",
                  "  Object.entries(headers).forEach(([key, value]) => {",
                  "    pm.request.headers.upsert({ key, value: pm.variables.replaceIn(String(value)) });",
                  "  });",
                  "}",
                  "",
                  "const serializedHeaders = JSON.stringify(headers);",
                  "const needsAdminToken = serializedHeaders.includes(\"{{adminToken}}\");",
                  "const needsUserToken = serializedHeaders.includes(\"{{userToken}}\");",
                  "",
                  "if (needsAdminToken) {",
                  "  loginAndStore(\"admin@eshop.com\", \"Admin123!\", \"adminToken\", maybeUser);",
                  "} else {",
                  "  maybeUser();",
                  "}",
                  "",
                  "function maybeUser() {",
                  "  if (!needsUserToken) return applyHeaders();",
                  "  loginAndStore(\"test@eshop.com\", \"Test1234!\", \"userToken\", applyHeaders);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const record = pm.iterationData.toObject();",
                  "",
                  "function expectedStatusCodes(value) {",
                  "  const matches = String(value).match(/\\b[1-5]\\d{2}\\b/g);",
                  "  return matches ? [...new Set(matches.map(Number))] : [];",
                  "}",
                  "",
                  "function responseText() {",
                  "  try { return pm.response && typeof pm.response.text === 'function' ? pm.response.text() : ''; }",
                  "  catch (error) { return ''; }",
                  "}",
                  "",
                  "function responseJsonOrNull() {",
                  "  try { return pm.response.json(); }",
                  "  catch (error) { return null; }",
                  "}",
                  "",
                  "function hasSensitiveKey(value) {",
                  "  if (!value || typeof value !== \"object\") return false;",
                  "  if (Array.isArray(value)) return value.some(hasSensitiveKey);",
                  "  return Object.entries(value).some(([key, child]) => {",
                  "    const normalized = key.toLowerCase();",
                  "    if ([\"password\", \"password_hash\", \"passwordhash\", \"reset_token\"].includes(normalized)) return true;",
                  "    return hasSensitiveKey(child);",
                  "  });",
                  "}",
                  "",
                  "pm.test(`${record.id} - ${record.title}`, function () {",
                  "  const codes = expectedStatusCodes(record.expectedStatus);",
                  "  pm.expect(pm.response.code).to.be.a(\"number\");",
                  "  pm.expect(codes, `expectedStatus=${record.expectedStatus}`).to.include(pm.response.code);",
                  "",
                  "  const text = responseText();",
                  "  const expectation = String(record.expectedResult || \"\").toLowerCase();",
                  "  const expectsJson = expectation.includes(\"json\") || expectation.includes(\"schema\");",
                  "  const json = responseJsonOrNull();",
                  "",
                  "  if (text && expectsJson) {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
                  "    pm.expect(json).to.not.equal(null);",
                  "  }",
                  "",
                  "  if (record.apiSlug !== \"auth\") {",
                  "    if (json !== null) {",
                  "      pm.expect(hasSensitiveKey(json), \"response must not expose sensitive keys\").to.equal(false);",
                  "    } else {",
                  "      const lowerText = text.toLowerCase();",
                  "      pm.expect(lowerText).to.not.include(\"password_hash\");",
                  "      pm.expect(lowerText).to.not.include(\"passwordhash\");",
                  "      pm.expect(lowerText).to.not.include(\"reset_token\");",
                  "    }",
                  "  }",
                  "",
                  "  if (record.path === '/api/apply-coupon' && pm.response.code === 200) {",
                  "    pm.expect(json).to.not.equal(null);",
                  "    pm.expect(json.discount_amount).to.be.a('number');",
                  "    pm.expect(json.final_amount).to.be.a('number');",
                  "  }",
                  "",
                  "  if (record.path === '/api/forgot-password' && pm.response.code === 200) {",
                  "    pm.expect(json).to.not.equal(null);",
                  "    pm.expect(json.message).to.be.a('string');",
                  "    if (json.resetToken !== undefined) pm.expect(json.resetToken).to.be.a('string');",
                  "  }",
                  "",
                  "  if (record.setTokenVariable && pm.response.code === 200) {",
                  "    pm.expect(json).to.not.equal(null);",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set(record.setTokenVariable, json.token);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "studentId",
      "value": "23127158"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "invalidToken",
      "value": "invalid-token-for-negative-test"
    },
    {
      "key": "expiredAdminToken",
      "value": "expired-or-invalid-token"
    },
    {
      "key": "couponCode",
      "value": "SAVE10"
    },
    {
      "key": "totalAmount",
      "value": "500000"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "expectedStatus",
      "value": "200"
    },
    {
      "key": "expectedHasDiscount",
      "value": "true"
    },
    {
      "key": "requestUrl",
      "value": "http://localhost:3000/api/forgot-password"
    }
  ]
}
