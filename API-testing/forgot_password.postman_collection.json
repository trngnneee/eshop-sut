{
  "info": {
    "name": "FR-03 Forgot Password API Test Suite - Data Driven",
    "description": "Data-driven Postman collection for FR-03 forgot-password and reset-password. Run with --iteration-data data/forgot-password.test-data.json. testCaseId identifies each row; assertions enables per-case deep checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Forgot Password - data-driven",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tc = pm.iterationData.toObject();",
              "",
              "pm.variables.set(\"testCaseId\", tc.testCaseId || \"FORGOT-PASSWORD-MANUAL\");",
              "pm.variables.set(\"testTitle\", tc.title || \"Manual forgot-password request\");",
              "pm.variables.set(\"requestMethod\", tc.method || \"POST\");",
              "pm.variables.set(\"requestPath\", tc.path || \"/api/forgot-password\");",
              "pm.variables.set(\"requestUrl\", pm.variables.get(\"baseUrl\") + pm.variables.get(\"requestPath\"));",
              "pm.variables.set(\"contentType\", tc.contentType || \"application/json\");",
              "pm.variables.set(\"requestBody\", tc.rawBody || \"{}\");",
              "",
              "function requestOptions(method, path, body) {",
              "  return {",
              "    url: pm.variables.get(\"baseUrl\") + path,",
              "    method: method || \"POST\",",
              "    header: {",
              "      \"Content-Type\": \"application/json\",",
              "      \"X-Student-Id\": pm.variables.get(\"studentId\")",
              "    },",
              "    body: {",
              "      mode: \"raw\",",
              "      raw: JSON.stringify(body || {})",
              "    }",
              "  };",
              "}",
              "",
              "function forgot(email, callback) {",
              "  pm.sendRequest(requestOptions(\"POST\", \"/api/forgot-password\", { email: email || pm.variables.get(\"testUserEmail\") }), callback);",
              "}",
              "",
              "function reset(email, token, password, callback) {",
              "  pm.sendRequest(requestOptions(\"POST\", \"/api/reset-password\", {",
              "    email: email || pm.variables.get(\"testUserEmail\"),",
              "    resetToken: token,",
              "    newPassword: password || pm.variables.get(\"testUserPassword\")",
              "  }), callback);",
              "}",
              "",
              "function applyRequestBodyFromToken(token) {",
              "  const parsed = JSON.parse(tc.rawBody || \"{}\");",
              "  parsed.resetToken = token;",
              "  pm.variables.set(\"requestBody\", JSON.stringify(parsed, null, 2));",
              "}",
              "",
              "pm.request.method = pm.variables.get(\"requestMethod\");",
              "pm.request.url.update(pm.variables.get(\"requestUrl\"));",
              "pm.request.headers.upsert({ key: \"Content-Type\", value: pm.variables.get(\"contentType\") });",
              "pm.request.headers.upsert({ key: \"X-Student-Id\", value: pm.variables.get(\"studentId\") });",
              "",
              "if (tc.method === \"GET\") {",
              "  pm.request.headers.remove(\"Content-Type\");",
              "}",
              "",
              "if (tc.setupFlow === \"freshOtp\") {",
              "  forgot(pm.variables.get(\"testUserEmail\"), function (error, response) {",
              "    pm.expect(error, \"fresh OTP setup error\").to.equal(null);",
              "    pm.expect(response.code, \"fresh OTP setup status\").to.eql(200);",
              "    applyRequestBodyFromToken(response.json().resetToken);",
              "  });",
              "}",
              "",
              "if (tc.setupFlow === \"otpForOtherUser\") {",
              "  forgot(pm.variables.get(\"testUserEmail\"), function (error, response) {",
              "    pm.expect(error, \"other-user OTP setup error\").to.equal(null);",
              "    pm.expect(response.code, \"other-user OTP setup status\").to.eql(200);",
              "    pm.variables.set(\"requestBody\", JSON.stringify({",
              "      email: pm.variables.get(\"adminEmail\"),",
              "      resetToken: response.json().resetToken,",
              "      newPassword: \"NewAdmin123!\"",
              "    }, null, 2));",
              "  });",
              "}",
              "",
              "if (tc.setupFlow === \"consumedOtp\") {",
              "  forgot(pm.variables.get(\"testUserEmail\"), function (error, response) {",
              "    pm.expect(error, \"consumed OTP setup error\").to.equal(null);",
              "    pm.expect(response.code, \"consumed OTP setup status\").to.eql(200);",
              "    const token = response.json().resetToken;",
              "    reset(pm.variables.get(\"testUserEmail\"), token, pm.variables.get(\"testUserPassword\"), function (resetError, resetResponse) {",
              "      pm.expect(resetError, \"consume OTP setup error\").to.equal(null);",
              "      pm.expect(resetResponse.code, \"consume OTP setup status\").to.eql(200);",
              "      applyRequestBodyFromToken(token);",
              "    });",
              "  });",
              "}",
              "",
              "if (tc.setupFlow === \"oldOtpInvalidated\") {",
              "  forgot(pm.variables.get(\"testUserEmail\"), function (error, firstResponse) {",
              "    pm.expect(error, \"old OTP setup error\").to.equal(null);",
              "    pm.expect(firstResponse.code, \"old OTP setup status\").to.eql(200);",
              "    const oldToken = firstResponse.json().resetToken;",
              "    forgot(pm.variables.get(\"testUserEmail\"), function (secondError, secondResponse) {",
              "      pm.expect(secondError, \"new OTP setup error\").to.equal(null);",
              "      pm.expect(secondResponse.code, \"new OTP setup status\").to.eql(200);",
              "      applyRequestBodyFromToken(oldToken);",
              "    });",
              "  });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tc = pm.iterationData.toObject();",
              "const testCaseId = tc.testCaseId || pm.variables.get(\"testCaseId\") || \"FORGOT-PASSWORD-MANUAL\";",
              "const assertions = Array.isArray(tc.assertions) ? tc.assertions : [];",
              "",
              "function hasAssertion(name) {",
              "  return assertions.includes(name);",
              "}",
              "",
              "function expectedStatusCodes(value) {",
              "  const matches = String(value).match(/\\b[1-5]\\d{2}\\b/g);",
              "  return matches ? [...new Set(matches.map(Number))] : [];",
              "}",
              "",
              "function jsonOrNull(response) {",
              "  try { return response ? response.json() : pm.response.json(); } catch (error) { return null; }",
              "}",
              "",
              "function expectJsonBody(response) {",
              "  const activeResponse = response || pm.response;",
              "  pm.expect(activeResponse.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
              "  const json = jsonOrNull(response);",
              "  pm.expect(json, \"response JSON body\").to.not.equal(null);",
              "  return json;",
              "}",
              "",
              "function expectNoSensitiveKeys(value) {",
              "  if (!value || typeof value !== \"object\") return;",
              "  if (Array.isArray(value)) return value.forEach(expectNoSensitiveKeys);",
              "  Object.keys(value).forEach(function (key) {",
              "    const normalized = key.toLowerCase();",
              "    pm.expect([\"password\", \"passwordhash\", \"password_hash\", \"reset_token\"]).to.not.include(normalized);",
              "    expectNoSensitiveKeys(value[key]);",
              "  });",
              "}",
              "",
              "function requestOptions(method, path, body) {",
              "  return {",
              "    url: pm.variables.get(\"baseUrl\") + path,",
              "    method: method || \"POST\",",
              "    header: {",
              "      \"Content-Type\": \"application/json\",",
              "      \"X-Student-Id\": pm.variables.get(\"studentId\")",
              "    },",
              "    body: {",
              "      mode: \"raw\",",
              "      raw: JSON.stringify(body || {})",
              "    }",
              "  };",
              "}",
              "",
              "function forgot(email, callback) {",
              "  pm.sendRequest(requestOptions(\"POST\", \"/api/forgot-password\", { email: email || pm.variables.get(\"testUserEmail\") }), callback);",
              "}",
              "",
              "function reset(email, token, password, callback) {",
              "  pm.sendRequest(requestOptions(\"POST\", \"/api/reset-password\", {",
              "    email: email || pm.variables.get(\"testUserEmail\"),",
              "    resetToken: token,",
              "    newPassword: password || pm.variables.get(\"testUserPassword\")",
              "  }), callback);",
              "}",
              "",
              "pm.test(testCaseId + \" - X-Student-Id header is attached\", function () {",
              "  pm.expect(pm.request.headers.get(\"X-Student-Id\")).to.eql(pm.variables.get(\"studentId\"));",
              "});",
              "",
              "pm.test(testCaseId + \" - expected HTTP status\", function () {",
              "  const expectedCodes = expectedStatusCodes(tc.expectedStatus);",
              "  pm.expect(expectedCodes, \"expectedStatus must contain at least one HTTP code\").to.not.be.empty;",
              "  pm.expect(expectedCodes, \"expected status list\").to.include(pm.response.code);",
              "});",
              "",
              "pm.test(testCaseId + \" - response has no sensitive fields\", function () {",
              "  const json = jsonOrNull();",
              "  if (json !== null) expectNoSensitiveKeys(json);",
              "});",
              "",
              "if (hasAssertion(\"successForgotSchema\")) {",
              "  pm.test(testCaseId + \" - forgot-password success response has message/resetToken\", function () {",
              "    if (pm.response.code < 200 || pm.response.code >= 300) return;",
              "    if (pm.request.url.getPath() !== \"/api/forgot-password\") return;",
              "    const json = expectJsonBody();",
              "    pm.expect(json.message).to.be.a(\"string\");",
              "    pm.expect(json.resetToken).to.be.a(\"string\");",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"errorOnly\")) {",
              "  pm.test(testCaseId + \" - error response does not expose success schema\", function () {",
              "    if (pm.response.code >= 200 && pm.response.code < 300) return;",
              "    const json = expectJsonBody();",
              "    pm.expect(json.error || json.message).to.be.a(\"string\");",
              "    pm.expect(json.resetToken).to.equal(undefined);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"otpSixDigits\")) {",
              "  pm.test(testCaseId + \" - OTP is exactly 6 digits\", function () {",
              "    const json = expectJsonBody();",
              "    pm.expect(json.resetToken).to.be.a(\"string\");",
              "    pm.expect(json.resetToken).to.match(/^[0-9]{6}$/);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"exactForgotSuccessSchema\")) {",
              "  pm.test(testCaseId + \" - success response has exact schema\", function () {",
              "    const json = expectJsonBody();",
              "    pm.expect(Object.keys(json).sort()).to.eql([\"message\", \"resetToken\"].sort());",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"noUserEnumerationMessage\")) {",
              "  pm.test(testCaseId + \" - unknown email message is generic\", function () {",
              "    const json = expectJsonBody();",
              "    pm.expect(String(json.error || json.message || \"\").toLowerCase()).to.not.include(\"user not found\");",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"noInternalLeak\")) {",
              "  pm.test(testCaseId + \" - response does not leak internals\", function () {",
              "    const text = pm.response.text().toLowerCase();",
              "    [\"sqlite\", \"sql syntax\", \"select *\", \"drop table\", \"server.js\", \"stack\"].forEach(function (needle) {",
              "      pm.expect(text).to.not.include(needle);",
              "    });",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"noRawScriptEcho\")) {",
              "  pm.test(testCaseId + \" - XSS payload is not reflected raw\", function () {",
              "    pm.expect(pm.response.text().toLowerCase()).to.not.include(\"<script>alert(1)</script>\");",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"otpCanResetPassword\")) {",
              "  pm.test(testCaseId + \" - generated OTP can reset password\", function (done) {",
              "    const token = expectJsonBody().resetToken;",
              "    reset(pm.variables.get(\"testUserEmail\"), token, pm.variables.get(\"testUserPassword\"), function (error, response) {",
              "      pm.expect(error).to.equal(null);",
              "      pm.expect(response.code).to.eql(200);",
              "      done();",
              "    });",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"newOtpInvalidatesOldOtp\")) {",
              "  pm.test(testCaseId + \" - new OTP invalidates previous OTP\", function (done) {",
              "    const oldToken = tc.setupFlow === \"oldOtpInvalidated\" ? JSON.parse(pm.variables.get(\"requestBody\")).resetToken : expectJsonBody().resetToken;",
              "    forgot(pm.variables.get(\"testUserEmail\"), function (error, response) {",
              "      pm.expect(error).to.equal(null);",
              "      pm.expect(response.code).to.eql(200);",
              "      const newToken = response.json().resetToken;",
              "      reset(pm.variables.get(\"testUserEmail\"), oldToken, \"OldShouldFail123!\", function (oldError, oldResponse) {",
              "        pm.expect(oldError).to.equal(null);",
              "        pm.expect(oldResponse.code).to.eql(400);",
              "        reset(pm.variables.get(\"testUserEmail\"), newToken, pm.variables.get(\"testUserPassword\"), function (newError, newResponse) {",
              "          pm.expect(newError).to.equal(null);",
              "          pm.expect(newResponse.code).to.eql(200);",
              "          done();",
              "        });",
              "      });",
              "    });",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"forgotDoesNotBreakLogin\")) {",
              "  pm.test(testCaseId + \" - forgot-password does not break current password\", function (done) {",
              "    pm.sendRequest(requestOptions(\"POST\", \"/api/login\", {",
              "      email: pm.variables.get(\"testUserEmail\"),",
              "      password: pm.variables.get(\"testUserPassword\")",
              "    }), function (error, response) {",
              "      pm.expect(error).to.equal(null);",
              "      pm.expect(response.code).to.eql(200);",
              "      done();",
              "    });",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"newCycleAfterReset\")) {",
              "  pm.test(testCaseId + \" - user can start a new forgot-password cycle after reset\", function (done) {",
              "    const token = expectJsonBody().resetToken;",
              "    reset(pm.variables.get(\"testUserEmail\"), token, pm.variables.get(\"testUserPassword\"), function (resetError, resetResponse) {",
              "      pm.expect(resetError).to.equal(null);",
              "      pm.expect(resetResponse.code).to.eql(200);",
              "      forgot(pm.variables.get(\"testUserEmail\"), function (forgotError, forgotResponse) {",
              "        pm.expect(forgotError).to.equal(null);",
              "        pm.expect(forgotResponse.code).to.eql(200);",
              "        pm.expect(forgotResponse.json().resetToken).to.be.a(\"string\");",
              "        done();",
              "      });",
              "    });",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"roleNotChanged\")) {",
              "  pm.test(testCaseId + \" - role field is not changed by forgot-password\", function (done) {",
              "    pm.sendRequest(requestOptions(\"POST\", \"/api/login\", {",
              "      email: pm.variables.get(\"testUserEmail\"),",
              "      password: pm.variables.get(\"testUserPassword\")",
              "    }), function (error, response) {",
              "      pm.expect(error).to.equal(null);",
              "      pm.expect(response.code).to.eql(200);",
              "      pm.expect(response.json().user.role).to.eql(\"user\");",
              "      done();",
              "    });",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"newOtpDiffers\")) {",
              "  pm.test(testCaseId + \" - new OTP differs from previous OTP\", function (done) {",
              "    const first = expectJsonBody().resetToken;",
              "    forgot(pm.variables.get(\"testUserEmail\"), function (error, response) {",
              "      pm.expect(error).to.equal(null);",
              "      pm.expect(response.code).to.eql(200);",
              "      pm.expect(response.json().resetToken).to.not.eql(first);",
              "      done();",
              "    });",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"otpBoundToEmail\")) {",
              "  pm.test(testCaseId + \" - OTP is bound to owner email\", function () {",
              "    pm.expect(pm.response.code).to.eql(400);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"consumedOtpRejected\")) {",
              "  pm.test(testCaseId + \" - consumed OTP is rejected\", function () {",
              "    pm.expect(pm.response.code).to.eql(400);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"weakPasswordRejected\")) {",
              "  pm.test(testCaseId + \" - weak new password is rejected\", function (done) {",
              "    function finishAfterCleanup() {",
              "      if (pm.response.code !== 400) {",
              "        return done(new Error(\"weak password should be rejected: expected 400 but got \" + pm.response.code));",
              "      }",
              "      done();",
              "    }",
              "",
              "    if (pm.response.code !== 200) return finishAfterCleanup();",
              "",
              "    forgot(pm.variables.get(\"testUserEmail\"), function (forgotError, forgotResponse) {",
              "      pm.expect(forgotError).to.equal(null);",
              "      pm.expect(forgotResponse.code).to.eql(200);",
              "      reset(pm.variables.get(\"testUserEmail\"), forgotResponse.json().resetToken, pm.variables.get(\"testUserPassword\"), function (resetError, resetResponse) {",
              "        pm.expect(resetError).to.equal(null);",
              "        pm.expect(resetResponse.code).to.eql(200);",
              "        finishAfterCleanup();",
              "      });",
              "    });",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"getDoesNotCreateOtp\")) {",
              "  pm.test(testCaseId + \" - GET does not create OTP\", function () {",
              "    pm.expect(pm.response.code).to.eql(404);",
              "    pm.expect(pm.response.text()).to.not.include(\"resetToken\");",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"cacheNoStore\")) {",
              "  pm.test(testCaseId + \" - OTP response is not cacheable\", function () {",
              "    const json = expectJsonBody();",
              "    pm.expect(json.resetToken).to.be.a(\"string\");",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\") || \"\").to.match(/no-store|no-cache/i);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "{{contentType}}"
          },
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{requestBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{requestUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "studentId",
      "value": "23127158"
    },
    {
      "key": "testUserEmail",
      "value": "test@eshop.com"
    },
    {
      "key": "testUserPassword",
      "value": "Test1234!"
    },
    {
      "key": "adminEmail",
      "value": "admin@eshop.com"
    }
  ]
}
