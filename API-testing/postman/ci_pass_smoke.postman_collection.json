{
  "info": {
    "name": "CI Pass Smoke Test Collection",
    "description": "Small all-pass smoke collection for CI evidence. It intentionally avoids known-bug APIs and checks stable public GET endpoints after database seed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "SMOKE-001 - GET /api/products returns seeded products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"SMOKE-001 - status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"SMOKE-001 - response is non-empty products array\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.be.an(\"array\");",
              "  pm.expect(json.length).to.be.at.least(5);",
              "  pm.expect(json[0]).to.have.property(\"id\");",
              "  pm.expect(json[0]).to.have.property(\"name\");",
              "  pm.expect(json[0]).to.have.property(\"price\");",
              "});",
              "",
              "pm.test(\"SMOKE-001 - X-Student-Id header is attached\", function () {",
              "  pm.expect(pm.request.headers.get(\"X-Student-Id\")).to.eql(pm.environment.get(\"studentId\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      },
      "response": []
    },
    {
      "name": "SMOKE-002 - GET /api/categories returns seeded categories",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"SMOKE-002 - status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"SMOKE-002 - response is non-empty categories array\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.be.an(\"array\");",
              "  pm.expect(json.length).to.be.at.least(3);",
              "  pm.expect(json.map(function (item) { return item.name; })).to.include(\"Điện thoại\");",
              "});",
              "",
              "pm.test(\"SMOKE-002 - X-Student-Id header is attached\", function () {",
              "  pm.expect(pm.request.headers.get(\"X-Student-Id\")).to.eql(pm.environment.get(\"studentId\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        }
      },
      "response": []
    },
    {
      "name": "SMOKE-003 - GET /api/products/1 returns seeded product detail",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"SMOKE-003 - status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"SMOKE-003 - seeded product detail is stable\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.be.an(\"object\");",
              "  pm.expect(json.id).to.eql(1);",
              "  pm.expect(json.name).to.eql(\"iPhone 15 Pro Max\");",
              "  pm.expect(json.price).to.be.a(\"number\");",
              "});",
              "",
              "pm.test(\"SMOKE-003 - X-Student-Id header is attached\", function () {",
              "  pm.expect(pm.request.headers.get(\"X-Student-Id\")).to.eql(pm.environment.get(\"studentId\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "1"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": []
}
