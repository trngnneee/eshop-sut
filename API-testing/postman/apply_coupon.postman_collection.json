{
  "info": {
    "name": "FR-09 Apply Coupon API Test Suite - Data Driven",
    "description": "Data-driven Postman collection for FR-09 POST /api/apply-coupon. Run with --iteration-data data/apply-coupon.test-data.json. testCaseId identifies each row; assertions enables per-case deep checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Apply Coupon - data-driven",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tc = pm.iterationData.toObject();",
              "",
              "pm.variables.set(\"testCaseId\", tc.testCaseId || \"APPLY-COUPON-MANUAL\");",
              "pm.variables.set(\"testTitle\", tc.title || \"Manual apply coupon request\");",
              "pm.variables.set(\"contentType\", tc.contentType || \"application/json\");",
              "pm.variables.set(\"requestBody\", tc.rawBody || \"{}\");",
              "pm.variables.set(\"isBlockedCase\", String(tc.expectedStatus).toUpperCase() === \"N/A\" ? \"true\" : \"false\");",
              "",
              "function applyAuthHeader() {",
              "  pm.request.headers.upsert({ key: \"Content-Type\", value: pm.variables.get(\"contentType\") });",
              "  pm.request.headers.upsert({ key: \"X-Student-Id\", value: pm.variables.get(\"studentId\") });",
              "",
              "  if (tc.authorization) {",
              "    pm.request.headers.upsert({ key: \"Authorization\", value: pm.variables.replaceIn(tc.authorization) });",
              "  } else {",
              "    pm.request.headers.remove(\"Authorization\");",
              "  }",
              "}",
              "",
              "function needsAutoUserLogin() {",
              "  return String(tc.authorization || \"\").includes(\"{{userToken}}\") && !pm.variables.get(\"userToken\");",
              "}",
              "",
              "if (needsAutoUserLogin()) {",
              "  pm.sendRequest({",
              "    url: pm.variables.get(\"baseUrl\") + \"/api/login\",",
              "    method: \"POST\",",
              "    header: {",
              "      \"Content-Type\": \"application/json\",",
              "      \"X-Student-Id\": pm.variables.get(\"studentId\")",
              "    },",
              "    body: {",
              "      mode: \"raw\",",
              "      raw: JSON.stringify({",
              "        email: pm.variables.get(\"testUserEmail\"),",
              "        password: pm.variables.get(\"testUserPassword\")",
              "      })",
              "    }",
              "  }, function (error, response) {",
              "    pm.expect(error, \"auto-login request error\").to.equal(null);",
              "    pm.expect(response.code, \"auto-login status\").to.eql(200);",
              "    const json = response.json();",
              "    pm.expect(json.token, \"auto-login token\").to.be.a(\"string\").and.not.empty;",
              "    pm.collectionVariables.set(\"userToken\", json.token);",
              "    applyAuthHeader();",
              "  });",
              "} else {",
              "  applyAuthHeader();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tc = pm.iterationData.toObject();",
              "const testCaseId = tc.testCaseId || pm.variables.get(\"testCaseId\") || \"APPLY-COUPON-MANUAL\";",
              "const assertions = Array.isArray(tc.assertions) ? tc.assertions : [];",
              "",
              "function hasAssertion(name) {",
              "  return assertions.includes(name);",
              "}",
              "",
              "function expectedStatusCodes(value) {",
              "  const matches = String(value).match(/\\b[1-5]\\d{2}\\b/g);",
              "  return matches ? [...new Set(matches.map(Number))] : [];",
              "}",
              "",
              "function jsonOrNull() {",
              "  try { return pm.response.json(); } catch (error) { return null; }",
              "}",
              "",
              "function expectJsonBody() {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
              "  const json = jsonOrNull();",
              "  pm.expect(json, \"response JSON body\").to.not.equal(null);",
              "  return json;",
              "}",
              "",
              "function expectNoSensitiveKeys(value) {",
              "  const text = JSON.stringify(value || {}).toLowerCase();",
              "  [\"password\", \"passwordhash\", \"password_hash\", \"resettoken\", \"reset_token\", \"token\"].forEach(function (key) {",
              "    pm.expect(text, \"sensitive field: \" + key).to.not.include(key);",
              "  });",
              "}",
              "",
              "if (String(tc.expectedStatus).toUpperCase() === \"N/A\") {",
              "  pm.test.skip(testCaseId + \" - BLOCKED / skipped: \" + (tc.expectedResult || \"non-executable by test design\"));",
              "  return;",
              "}",
              "",
              "pm.test(testCaseId + \" - X-Student-Id header is attached\", function () {",
              "  pm.expect(pm.request.headers.get(\"X-Student-Id\")).to.eql(pm.variables.get(\"studentId\"));",
              "});",
              "",
              "pm.test(testCaseId + \" - expected HTTP status\", function () {",
              "  const expectedCodes = expectedStatusCodes(tc.expectedStatus);",
              "  pm.expect(expectedCodes, \"expectedStatus must contain at least one HTTP code\").to.not.be.empty;",
              "  pm.expect(expectedCodes, \"expected status list\").to.include(pm.response.code);",
              "});",
              "",
              "pm.test(testCaseId + \" - response has no sensitive fields\", function () {",
              "  const json = jsonOrNull();",
              "  if (json !== null) expectNoSensitiveKeys(json);",
              "});",
              "",
              "if (hasAssertion(\"successAmounts\")) {",
              "  pm.test(testCaseId + \" - success response has discount and final amounts\", function () {",
              "    if (pm.response.code < 200 || pm.response.code >= 300) return;",
              "    const json = expectJsonBody();",
              "    pm.expect(json.discount_amount).to.be.a(\"number\");",
              "    pm.expect(json.final_amount).to.be.a(\"number\");",
              "    pm.expect(json.discount_amount).to.be.at.least(0);",
              "    pm.expect(json.final_amount).to.be.at.least(0);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"errorOnly\")) {",
              "  pm.test(testCaseId + \" - error response does not look like success schema\", function () {",
              "    if (pm.response.code >= 200 && pm.response.code < 300) return;",
              "    const json = expectJsonBody();",
              "    pm.expect(json.discount_amount).to.equal(undefined);",
              "    pm.expect(json.final_amount).to.equal(undefined);",
              "    pm.expect(String(json.error || json.message || \"\")).to.not.equal(\"\");",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"finalAmountFormula\")) {",
              "  pm.test(testCaseId + \" - final_amount follows total_amount - discount_amount\", function () {",
              "    const json = expectJsonBody();",
              "    const sent = JSON.parse(tc.rawBody);",
              "    pm.expect(json.final_amount).to.eql(sent.total_amount - json.discount_amount);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"save10ExactCalculation\")) {",
              "  pm.test(testCaseId + \" - SAVE10 exact percent calculation\", function () {",
              "    const json = expectJsonBody();",
              "    pm.expect(json.discount_amount).to.eql(50000);",
              "    pm.expect(json.final_amount).to.eql(450000);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"bigbuyExactCalculation\")) {",
              "  pm.test(testCaseId + \" - BIGBUY exact fixed calculation\", function () {",
              "    const json = expectJsonBody();",
              "    pm.expect(json.discount_amount).to.eql(50000);",
              "    pm.expect(json.final_amount).to.eql(550000);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"moneyBounds\")) {",
              "  pm.test(testCaseId + \" - money fields stay within safe bounds\", function () {",
              "    const json = expectJsonBody();",
              "    const sent = JSON.parse(tc.rawBody);",
              "    pm.expect(json.discount_amount).to.be.at.least(0);",
              "    pm.expect(json.discount_amount).to.be.at.most(sent.total_amount);",
              "    pm.expect(json.final_amount).to.be.at.least(0);",
              "    pm.expect(json.final_amount).to.be.at.most(sent.total_amount);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"previewNoSideEffect\")) {",
              "  pm.test(testCaseId + \" - second preview call is still allowed\", function (done) {",
              "    pm.sendRequest({",
              "      url: pm.variables.get(\"baseUrl\") + \"/api/apply-coupon\",",
              "      method: \"POST\",",
              "      header: {",
              "        \"Content-Type\": \"application/json\",",
              "        \"X-Student-Id\": pm.variables.get(\"studentId\")",
              "      },",
              "      body: {",
              "        mode: \"raw\",",
              "        raw: tc.rawBody",
              "      }",
              "    }, function (error, response) {",
              "      pm.expect(error).to.equal(null);",
              "      pm.expect(response.code).to.eql(200);",
              "      const json = response.json();",
              "      pm.expect(json.discount_amount).to.be.a(\"number\");",
              "      pm.expect(json.final_amount).to.be.a(\"number\");",
              "      done();",
              "    });",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"noExtraSuccessObjects\")) {",
              "  pm.test(testCaseId + \" - success response avoids extra objects\", function () {",
              "    const json = expectJsonBody();",
              "    pm.expect(json.user).to.equal(undefined);",
              "    pm.expect(json.coupon).to.equal(undefined);",
              "    pm.expect(json.password).to.equal(undefined);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"mentionsCode\")) {",
              "  pm.test(testCaseId + \" - validation error mentions coupon code\", function () {",
              "    const json = expectJsonBody();",
              "    pm.expect(String(json.error || json.message || \"\")).to.match(/ma|mã|code|coupon/i);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"jsonErrorResponse\")) {",
              "  pm.test(testCaseId + \" - error response is stable JSON\", function () {",
              "    if (pm.response.code >= 400) {",
              "      const json = expectJsonBody();",
              "      pm.expect(json.error || json.message).to.be.a(\"string\");",
              "    }",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"noSqlLeak\")) {",
              "  pm.test(testCaseId + \" - SQL injection attempt does not leak internals\", function () {",
              "    const text = pm.response.text().toLowerCase();",
              "    pm.expect(pm.response.code).to.not.equal(500);",
              "    [\"sqlite\", \"sql syntax\", \"select *\", \"drop table\", \"server.js\", \"stack\"].forEach(function (needle) {",
              "      pm.expect(text).to.not.include(needle);",
              "    });",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"noRawScriptEcho\")) {",
              "  pm.test(testCaseId + \" - XSS payload is not reflected as executable markup\", function () {",
              "    pm.expect(pm.response.text().toLowerCase()).to.not.include(\"<script>alert(1)</script>\");",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"ignoreClientDiscount\")) {",
              "  pm.test(testCaseId + \" - client discount_amount is ignored or rejected\", function () {",
              "    if (pm.response.code >= 200 && pm.response.code < 300) {",
              "      const json = expectJsonBody();",
              "      pm.expect(json.discount_amount).to.not.eql(499999);",
              "    }",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"ignoreClientFinalAmount\")) {",
              "  pm.test(testCaseId + \" - client final_amount is ignored or rejected\", function () {",
              "    if (pm.response.code >= 200 && pm.response.code < 300) {",
              "      const json = expectJsonBody();",
              "      pm.expect(json.final_amount).to.not.eql(1);",
              "    }",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "{{contentType}}"
          },
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{requestBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/apply-coupon",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "apply-coupon"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "studentId",
      "value": "23127158"
    },
    {
      "key": "testUserEmail",
      "value": "test@eshop.com"
    },
    {
      "key": "testUserPassword",
      "value": "Test1234!"
    },
    {
      "key": "userToken",
      "value": ""
    }
  ]
}
