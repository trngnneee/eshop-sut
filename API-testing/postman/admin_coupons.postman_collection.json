{
  "info": {
    "name": "FR-17 Admin Coupons API Test Suite - Data Driven",
    "description": "Data-driven Postman collection for FR-17 POST /api/admin/coupons. Run with --iteration-data data/admin-coupons.test-data.json. The collection auto-logins admin/user tokens as required by each row.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin Coupons - data-driven",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tc = pm.iterationData.toObject();",
              "const assertions = Array.isArray(tc.assertions) ? tc.assertions : [];",
              "const shouldSkip = String(tc.expectedStatus).toUpperCase() === \"N/A\" || assertions.includes(\"skip\");",
              "",
              "pm.variables.set(\"testCaseId\", tc.testCaseId || \"ADMIN-COUPONS-MANUAL\");",
              "pm.variables.set(\"testTitle\", tc.title || \"Manual admin coupon request\");",
              "pm.variables.set(\"requestMethod\", shouldSkip ? \"POST\" : (tc.method || \"POST\"));",
              "pm.variables.set(\"requestPath\", shouldSkip ? \"/api/admin/coupons\" : (tc.path || \"/api/admin/coupons\"));",
              "pm.variables.set(\"requestUrl\", pm.variables.get(\"baseUrl\") + pm.variables.get(\"requestPath\"));",
              "pm.variables.set(\"contentType\", tc.contentType || \"application/json\");",
              "",
              "if (!pm.collectionVariables.get(\"adminRunId\")) {",
              "  pm.collectionVariables.set(\"adminRunId\", String(Date.now()).slice(-8));",
              "}",
              "",
              "function base64Url(input) {",
              "  return CryptoJS.enc.Base64.stringify(input)",
              "    .replace(/=/g, \"\")",
              "    .replace(/\\+/g, \"-\")",
              "    .replace(/\\//g, \"_\");",
              "}",
              "",
              "function jwtSign(payload) {",
              "  const header = base64Url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: \"HS256\", typ: \"JWT\" })));",
              "  const body = base64Url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
              "  const data = header + \".\" + body;",
              "  const signature = base64Url(CryptoJS.HmacSHA256(data, pm.variables.get(\"jwtSecret\")));",
              "  return data + \".\" + signature;",
              "}",
              "",
              "if (!pm.collectionVariables.get(\"expiredAdminToken\")) {",
              "  pm.collectionVariables.set(\"expiredAdminToken\", jwtSign({ id: 1, role: \"admin\", iat: 1, exp: 2 }));",
              "}",
              "",
              "if (!pm.collectionVariables.get(\"forgedAdminRoleToken\")) {",
              "  const header = base64Url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: \"HS256\", typ: \"JWT\" })));",
              "  const payload = base64Url(CryptoJS.enc.Utf8.parse(JSON.stringify({ id: 2, role: \"admin\", iat: Math.floor(Date.now() / 1000) })));",
              "  pm.collectionVariables.set(\"forgedAdminRoleToken\", header + \".\" + payload + \".invalidsignature\");",
              "}",
              "",
              "function requestOptions(email, password) {",
              "  return {",
              "    url: pm.variables.get(\"baseUrl\") + \"/api/login\",",
              "    method: \"POST\",",
              "    header: {",
              "      \"Content-Type\": \"application/json\",",
              "      \"X-Student-Id\": pm.variables.get(\"studentId\")",
              "    },",
              "    body: {",
              "      mode: \"raw\",",
              "      raw: JSON.stringify({ email: email, password: password })",
              "    }",
              "  };",
              "}",
              "",
              "function applyRequest() {",
              "  pm.request.method = pm.variables.get(\"requestMethod\");",
              "  pm.request.url.update(pm.variables.replaceIn(pm.variables.get(\"requestUrl\")));",
              "  pm.request.headers.upsert({ key: \"Content-Type\", value: pm.variables.get(\"contentType\") });",
              "  pm.request.headers.upsert({ key: \"X-Student-Id\", value: pm.variables.get(\"studentId\") });",
              "  pm.variables.set(\"requestBody\", shouldSkip ? \"{}\" : pm.variables.replaceIn(tc.rawBody || \"{}\"));",
              "",
              "  if (shouldSkip) {",
              "    pm.request.headers.remove(\"Authorization\");",
              "  } else if (tc.authorization === \"__EMPTY_AUTH_HEADER__\") {",
              "    pm.request.headers.upsert({ key: \"Authorization\", value: \"\" });",
              "  } else if (tc.authorization) {",
              "    pm.request.headers.upsert({ key: \"Authorization\", value: pm.variables.replaceIn(tc.authorization) });",
              "  } else {",
              "    pm.request.headers.remove(\"Authorization\");",
              "  }",
              "}",
              "",
              "function adminRequest(body, callback) {",
              "  pm.sendRequest({",
              "    url: pm.variables.get(\"baseUrl\") + \"/api/admin/coupons\",",
              "    method: \"POST\",",
              "    header: {",
              "      \"Content-Type\": \"application/json\",",
              "      \"X-Student-Id\": pm.variables.get(\"studentId\"),",
              "      \"Authorization\": \"Bearer \" + pm.collectionVariables.get(\"adminToken\")",
              "    },",
              "    body: {",
              "      mode: \"raw\",",
              "      raw: JSON.stringify(body || {})",
              "    }",
              "  }, callback);",
              "}",
              "",
              "function setupThenApply() {",
              "  if (tc.setupFlow === \"precreateDuplicate\") {",
              "    const body = JSON.parse(pm.variables.replaceIn(tc.rawBody || \"{}\"));",
              "    adminRequest(body, function () {",
              "      applyRequest();",
              "    });",
              "  } else if (tc.setupFlow === \"createCouponForDelete\") {",
              "    const code = \"DEL\" + pm.collectionVariables.get(\"adminRunId\") + String(pm.info.iteration).padStart(2, \"0\");",
              "    adminRequest({",
              "      code: code,",
              "      type: \"percent\",",
              "      discount_value: 10,",
              "      min_order_amount: 100000,",
              "      expired_at: \"2099-12-31\",",
              "      max_uses_per_user: 1",
              "    }, function (error, response) {",
              "      pm.expect(error, \"create delete fixture error\").to.equal(null);",
              "      pm.expect(response.code, \"create delete fixture status\").to.eql(200);",
              "      pm.collectionVariables.set(\"createdCouponId\", response.json().id);",
              "      applyRequest();",
              "    });",
              "  } else if (tc.setupFlow === \"deleteCouponBeforeMain\") {",
              "    const code = \"DELAGAIN\" + pm.collectionVariables.get(\"adminRunId\") + String(pm.info.iteration).padStart(2, \"0\");",
              "    adminRequest({",
              "      code: code,",
              "      type: \"percent\",",
              "      discount_value: 10,",
              "      min_order_amount: 100000,",
              "      expired_at: \"2099-12-31\",",
              "      max_uses_per_user: 1",
              "    }, function (error, response) {",
              "      pm.expect(error, \"create deleted fixture error\").to.equal(null);",
              "      pm.expect(response.code, \"create deleted fixture status\").to.eql(200);",
              "      const id = response.json().id;",
              "      pm.collectionVariables.set(\"deletedCouponId\", id);",
              "      pm.sendRequest({",
              "        url: pm.variables.get(\"baseUrl\") + \"/api/admin/coupons/\" + id,",
              "        method: \"DELETE\",",
              "        header: {",
              "          \"Content-Type\": \"application/json\",",
              "          \"X-Student-Id\": pm.variables.get(\"studentId\"),",
              "          \"Authorization\": \"Bearer \" + pm.collectionVariables.get(\"adminToken\")",
              "        }",
              "      }, function (deleteError) {",
              "        pm.expect(deleteError, \"pre-delete fixture error\").to.equal(null);",
              "        applyRequest();",
              "      });",
              "    });",
              "  } else if (tc.setupFlow === \"raceDuplicate\") {",
              "    const body = JSON.parse(pm.variables.replaceIn(tc.rawBody || \"{}\"));",
              "    var raceResults = [];",
              "    var raceCompleted = 0;",
              "    function onBothDone() {",
              "      var codes = raceResults.map(function (r) { return r.code; });",
              "      var successes = codes.filter(function (c) { return c >= 200 && c < 300; }).length;",
              "      pm.collectionVariables.set(\"raceSuccessCount\", String(successes));",
              "      pm.collectionVariables.set(\"raceStatusCodes\", JSON.stringify(codes));",
              "      applyRequest();",
              "    }",
              "    adminRequest(body, function (err, res) {",
              "      raceResults.push({ code: res ? res.code : 0 });",
              "      raceCompleted++;",
              "      if (raceCompleted === 2) onBothDone();",
              "    });",
              "    adminRequest(body, function (err, res) {",
              "      raceResults.push({ code: res ? res.code : 0 });",
              "      raceCompleted++;",
              "      if (raceCompleted === 2) onBothDone();",
              "    });",
              "  } else {",
              "    applyRequest();",
              "  }",
              "}",
              "",
              "function needsAdminLogin() {",
              "  const setupNeedsAdmin = [\"precreateDuplicate\", \"raceDuplicate\", \"createCouponForDelete\", \"deleteCouponBeforeMain\"].includes(tc.setupFlow);",
              "  return (setupNeedsAdmin || String(tc.authorization || \"\").includes(\"{{adminToken}}\")) && !pm.collectionVariables.get(\"adminToken\");",
              "}",
              "",
              "function needsUserLogin() {",
              "  return String(tc.authorization || \"\").includes(\"{{userToken}}\") && !pm.collectionVariables.get(\"userToken\");",
              "}",
              "",
              "function loginAdminThen(next) {",
              "  pm.sendRequest(requestOptions(pm.variables.get(\"adminEmail\"), pm.variables.get(\"adminPassword\")), function (error, response) {",
              "    pm.expect(error, \"admin auto-login request error\").to.equal(null);",
              "    pm.expect(response.code, \"admin auto-login status\").to.eql(200);",
              "    pm.collectionVariables.set(\"adminToken\", response.json().token);",
              "    next();",
              "  });",
              "}",
              "",
              "function loginUserThen(next) {",
              "  pm.sendRequest(requestOptions(pm.variables.get(\"testUserEmail\"), pm.variables.get(\"testUserPassword\")), function (error, response) {",
              "    pm.expect(error, \"user auto-login request error\").to.equal(null);",
              "    pm.expect(response.code, \"user auto-login status\").to.eql(200);",
              "    pm.collectionVariables.set(\"userToken\", response.json().token);",
              "    next();",
              "  });",
              "}",
              "",
              "if (needsAdminLogin()) {",
              "  loginAdminThen(function () {",
              "    if (needsUserLogin()) loginUserThen(setupThenApply);",
              "    else setupThenApply();",
              "  });",
              "} else if (needsUserLogin()) {",
              "  loginUserThen(setupThenApply);",
              "} else {",
              "  setupThenApply();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tc = pm.iterationData.toObject();",
              "const testCaseId = tc.testCaseId || pm.variables.get(\"testCaseId\") || \"ADMIN-COUPONS-MANUAL\";",
              "const assertions = Array.isArray(tc.assertions) ? tc.assertions : [];",
              "",
              "function hasAssertion(name) {",
              "  return assertions.includes(name);",
              "}",
              "",
              "function expectedStatusCodes(value) {",
              "  const matches = String(value).match(/\\b[1-5]\\d{2}\\b/g);",
              "  return matches ? [...new Set(matches.map(Number))] : [];",
              "}",
              "",
              "function jsonOrNull(response) {",
              "  try { return response ? response.json() : pm.response.json(); } catch (error) { return null; }",
              "}",
              "",
              "function expectJsonBody(response) {",
              "  const activeResponse = response || pm.response;",
              "  pm.expect(activeResponse.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
              "  const json = jsonOrNull(response);",
              "  pm.expect(json, \"response JSON body\").to.not.equal(null);",
              "  return json;",
              "}",
              "",
              "function expectNoSensitiveKeys(value) {",
              "  const text = JSON.stringify(value || {}).toLowerCase();",
              "  [\"password\", \"passwordhash\", \"password_hash\", \"resettoken\", \"reset_token\", \"token\", \"refreshtoken\"].forEach(function (key) {",
              "    pm.expect(text, \"sensitive field: \" + key).to.not.include(key);",
              "  });",
              "}",
              "",
              "if (String(tc.expectedStatus).toUpperCase() === \"N/A\" || hasAssertion(\"skip\")) {",
              "  pm.test.skip(testCaseId + \" - NOT EXECUTED / skipped: \" + (tc.skipReason || \"outside current scope\"));",
              "  return;",
              "}",
              "",
              "pm.test(testCaseId + \" - X-Student-Id header is attached\", function () {",
              "  pm.expect(pm.request.headers.get(\"X-Student-Id\")).to.eql(pm.variables.get(\"studentId\"));",
              "});",
              "",
              "pm.test(testCaseId + \" - expected HTTP status\", function () {",
              "  const expectedCodes = expectedStatusCodes(tc.expectedStatus);",
              "  pm.expect(expectedCodes, \"expectedStatus must contain at least one HTTP code\").to.not.be.empty;",
              "  pm.expect(expectedCodes, \"expected status list\").to.include(pm.response.code);",
              "});",
              "",
              "pm.test(testCaseId + \" - response has no sensitive fields\", function () {",
              "  const json = jsonOrNull();",
              "  if (json !== null) expectNoSensitiveKeys(json);",
              "});",
              "",
              "if (hasAssertion(\"successCreateSchema\")) {",
              "  pm.test(testCaseId + \" - create success response has message/id\", function () {",
              "    if (pm.response.code < 200 || pm.response.code >= 300) return;",
              "    const json = expectJsonBody();",
              "    pm.expect(json.message).to.be.a(\"string\");",
              "    pm.expect(json.id).to.be.a(\"number\");",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"errorOnly\")) {",
              "  pm.test(testCaseId + \" - error response does not look like success schema\", function () {",
              "    if (pm.response.code >= 200 && pm.response.code < 300) return;",
              "    const json = expectJsonBody();",
              "    pm.expect(json.id).to.equal(undefined);",
              "    pm.expect(json.error || json.message).to.be.a(\"string\");",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"idNumber\")) {",
              "  pm.test(testCaseId + \" - response id is number\", function () {",
              "    if (pm.response.code < 200 || pm.response.code >= 300) return;",
              "    const json = expectJsonBody();",
              "    pm.expect(json.id).to.be.a(\"number\");",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"messageString\")) {",
              "  pm.test(testCaseId + \" - response message is string\", function () {",
              "    const json = expectJsonBody();",
              "    pm.expect(json.message || json.error).to.be.a(\"string\");",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"successDeleteSchema\")) {",
              "  pm.test(testCaseId + \" - delete success response has message only\", function () {",
              "    if (pm.response.code < 200 || pm.response.code >= 300) return;",
              "    const json = expectJsonBody();",
              "    pm.expect(json.message).to.be.a(\"string\");",
              "    pm.expect(json.id).to.equal(undefined);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"noSensitiveFields\")) {",
              "  pm.test(testCaseId + \" - response avoids sensitive fields\", function () {",
              "    const json = jsonOrNull();",
              "    if (json !== null) expectNoSensitiveKeys(json);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"noSqlLeak\")) {",
              "  pm.test(testCaseId + \" - SQL payload does not leak internals\", function () {",
              "    const text = pm.response.text().toLowerCase();",
              "    [\"sqlite\", \"sql syntax\", \"select *\", \"drop table\", \"server.js\", \"stack\"].forEach(function (needle) {",
              "      pm.expect(text).to.not.include(needle);",
              "    });",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"noRawScriptEcho\")) {",
              "  pm.test(testCaseId + \" - XSS payload is not reflected raw\", function () {",
              "    pm.expect(pm.response.text().toLowerCase()).to.not.include(\"<script>alert(1)</script>\");",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"noWhitespaceCodeCreated\")) {",
              "  pm.test(testCaseId + \" - whitespace code is rejected or canonicalized\", function () {",
              "    if (pm.response.code >= 200 && pm.response.code < 300) {",
              "      const sent = JSON.parse(pm.variables.replaceIn(tc.rawBody || \"{}\"));",
              "      pm.expect(sent.code).to.eql(sent.code.trim());",
              "    }",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"caseInsensitiveDuplicate\")) {",
              "  pm.test(testCaseId + \" - case-insensitive duplicate is rejected\", function () {",
              "    pm.expect(pm.response.code).to.not.be.within(200, 299);",
              "  });",
              "}",
              "",
              "if (hasAssertion(\"raceDuplicate\")) {",
              "  pm.test(testCaseId + \" - race: exactly one of two concurrent requests succeeded\", function () {",
              "    var successCount = parseInt(pm.collectionVariables.get(\"raceSuccessCount\") || \"0\");",
              "    pm.expect(successCount).to.equal(1, \"exactly 1 of 2 concurrent requests must succeed\");",
              "  });",
              "  pm.test(testCaseId + \" - race: duplicate request was rejected (expected 409; SUT returns 500 - BUG-002)\", function () {",
              "    var codes = JSON.parse(pm.collectionVariables.get(\"raceStatusCodes\") || \"[]\");",
              "    var rejections = codes.filter(function (c) { return c < 200 || c >= 300; });",
              "    pm.expect(rejections.length).to.equal(1, \"one request must be rejected as duplicate\");",
              "    pm.expect([409, 500]).to.include(rejections[0], \"rejection must be 409 (correct) or 500 (SUT bug per BUG-ADMIN-COUPONS-002)\");",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "{{contentType}}"
          },
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{requestBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{requestUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "studentId",
      "value": "23127158"
    },
    {
      "key": "adminEmail",
      "value": "admin@eshop.com"
    },
    {
      "key": "adminPassword",
      "value": "Admin123!"
    },
    {
      "key": "testUserEmail",
      "value": "test@eshop.com"
    },
    {
      "key": "testUserPassword",
      "value": "Test1234!"
    },
    {
      "key": "jwtSecret",
      "value": "super_secret_key_that_should_not_be_here"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "expiredAdminToken",
      "value": ""
    },
    {
      "key": "forgedAdminRoleToken",
      "value": ""
    },
    {
      "key": "adminRunId",
      "value": ""
    }
  ]
}
