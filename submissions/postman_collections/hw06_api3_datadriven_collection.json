{
  "info": {
    "_postman_id": "c3d4e5f6-dd03-4000-8000-000000000003",
    "name": "HW06 – Data-Driven API 3 (POST /api/admin/import-products)",
    "description": "Data-Driven Test Suite for FR-16 Admin Product Import using iteration data JSON",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "SETUP Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@eshop.com\",\"password\":\"Admin123!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var j = pm.response.json();",
              "    if (j.token) pm.environment.set('adminToken', j.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "SETUP Login regular user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"test@eshop.com\",\"password\":\"Test1234!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var j = pm.response.json();",
              "    if (j.token) pm.environment.set('token', j.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /api/admin/import-products [Data-Driven Runner]",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var tc_id = pm.iterationData.get('tc_id') || 'TC-C-DD';",
              "var desc = pm.iterationData.get('description') || '';",
              "var auth_role = pm.iterationData.get('auth_role') || 'admin';",
              "var payload = pm.iterationData.get('payload');",
              "",
              "pm.request.headers.upsert({",
              "  key: 'X-Student-Id',",
              "  value: pm.environment.get('studentId') || '23127486'",
              "});",
              "",
              "// Apply auth header based on auth_role",
              "if (auth_role === 'admin') {",
              "    var aToken = pm.environment.get('adminToken');",
              "    if (aToken) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + aToken });",
              "} else if (auth_role === 'user') {",
              "    var uToken = pm.environment.get('token');",
              "    if (uToken) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + uToken });",
              "} else if (auth_role === 'none') {",
              "    pm.request.headers.remove('Authorization');",
              "}",
              "",
              "pm.variables.set('req_body', JSON.stringify(payload));",
              "console.log('[DD API3] Running ' + tc_id + ': ' + desc);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var tc_id = pm.iterationData.get('tc_id') || 'TC-C-DD';",
              "var desc = pm.iterationData.get('description') || '';",
              "var expected_status = pm.iterationData.get('expected_status') || 200;",
              "",
              "pm.test('[' + tc_id + '] ' + desc + ' -> Status is ' + expected_status, function () {",
              "    pm.response.to.have.status(expected_status);",
              "});",
              "",
              "pm.test('[' + tc_id + '] Response Content-Type is JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "if (expected_status === 200) {",
              "    pm.test('[' + tc_id + '] Response has success result structure', function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(typeof jsonData).to.equal('object');",
              "        pm.expect(jsonData).to.not.be.null;",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{req_body}}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/import-products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "import-products"
          ]
        }
      },
      "response": []
    }
  ]
}
