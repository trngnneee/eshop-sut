{
  "name": "eshop-automation-testing",
  "version": "1.0.0",
  "description": "HW04 — Data-driven Playwright automation for EShop SUT (FR-02 Login/Lockout, FR-09 Coupon, FR-14 Category CRUD)",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:fr02": "REPORT_DIR=reports/fr02-login playwright test fr02-login.spec.ts",
