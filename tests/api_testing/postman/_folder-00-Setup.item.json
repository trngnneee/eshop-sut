            "login"
          ]
        },
        "description": "Fixture — lấy JWT của tài khoản seed user thường (users.id=2, role='user').\n\nDùng cho: API-2 (user tự hủy đơn của mình), case IDOR, và case 'token role=user gọi API-3 phải bị 403' (SEC-03)."
      }
    },
    {
      "name": "SETUP-03 — Tạo product mẫu → {{productId}}",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "id": "23127438-setup-03-prerequest",
            "type": "text/javascript",
            "exec": [
              "// Tên product phải DUY NHẤT mỗi lần chạy (tránh trùng khi chạy lại suite mà chưa restart server).",
              "// Dùng dynamic variable của Postman + timestamp, rồi lưu lại để các folder sau đối chiếu được.",
              "const seedName = pm.variables.replaceIn('HW06 {{$randomProductName}} {{$timestamp}}');",
              "pm.environment.set('seedProductName', seedName);",
              "console.log('[HW06][SETUP-03] seedProductName =', seedName);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "id": "23127438-setup-03-test",
            "type": "text/javascript",
            "exec": [
              "// ---- SETUP-03 · POST /api/products -> {{productId}} ----",
              "// Payload HỢP LỆ theo FR-15 (name <= 255, price > 0, category_id thuộc {1,2,3})",
              "// => contract kỳ vọng 200 + {message, id}. Đây là fixture, PHẢI PASS.",
              "// Ghi chú: SUT không gắn authenticateToken cho route này (BUG-07) nhưng request vẫn gửi",
              "// Bearer {{adminToken}} cho ĐÚNG thiết kế theo spec (FR-12: CRUD sản phẩm dành cho Admin).",
              "const ok   = pm.response.code === 200;",
              "const json = ok ? pm.response.json() : {};",
              "",
              "pm.test('SETUP-03 · status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('SETUP-03 · khớp created-response schema {message, id}', function () {",
              "    const schema = JSON.parse(pm.collectionVariables.get('createdSchema'));",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "pm.test('SETUP-03 · id là số nguyên > 5 (ngoài 5 product seed)', function () {",
              "    pm.expect(json.id, 'id').to.be.a('number');",
              "    pm.expect(Number.isInteger(json.id), 'id phải là integer').to.be.true;",
              "    pm.expect(json.id).to.be.above(5);",
              "});",
              "",
              "if (json.id) {",
              "    pm.environment.set('productId', json.id);",
              "    console.log('[HW06][SETUP-03] productId =', json.id, '| name =', pm.environment.get('seedProductName'));",
              "}",
              "",
              "pm.test('SETUP-03 · đã set environment {{productId}}', function () {",
              "    pm.expect(pm.environment.get('productId'), 'productId').to.not.be.empty;",
              "});",
              "",
              "pm.test('SETUP-03 · response time < 2000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{seedProductName}}\",\n  \"price\": 8500000,\n  \"description\": \"Seed product của HW06 — tạo bởi folder 00-Setup\",\n  \"imageUrl\": \"http://localhost:3000/img/hw06-seed.png\",\n  \"category_id\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Fixture — tạo 1 product HỢP LỆ theo FR-15 để các folder sau có id ổn định ({{productId}}) mà không phải hardcode id seed 1..5.\n\n`name` dùng dynamic variable `{{$randomProductName}}` + `{{$timestamp}}` (sinh ở pre-request script, lưu vào `{{seedProductName}}`) nên chạy lại nhiều lần không trùng tên.\n\nRequest gửi `Bearer {{adminToken}}` cho đúng thiết kế theo spec (FR-12: CRUD sản phẩm dành cho Admin), mặc dù SUT quên gắn middleware `authenticateToken` (BUG-07). Việc chứng minh BUG-07 nằm ở folder `03-API3-Product-Manage > Auth-Escalation`, không phải ở đây."
      }
    },
    {
      "name": "SETUP-04 — Checkout tạo đơn pending → {{orderId}}",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "23127438-setup-04-test",
            "type": "text/javascript",
            "exec": [
              "// ---- SETUP-04 · POST /api/checkout (Bearer {{userToken}}) -> {{orderId}} ----",
              "// Đơn vừa tạo luôn ở state 'pending' (server.js:303 hardcode 'pending').",
              "// Đây là đơn dùng cho các case \"đơn của chính mình\" ở API-2.",
              "// Các đơn theo TỪNG state (ordPending/ordConfirmed/ordShipping/ordDelivered/ordCanceled)",
              "// được dựng riêng ở folder 02-API2-Order-Cancel > Fixtures.",
              "const ok   = pm.response.code === 200;",
              "const json = ok ? pm.response.json() : {};",
              "",
              "pm.test('SETUP-04 · status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('SETUP-04 · body có {message, orderId}', function () {",
              "    pm.expect(json).to.have.property('message');",
              "    pm.expect(json).to.have.property('orderId');",
              "    pm.expect(json.orderId, 'orderId').to.be.a('number');",
              "    pm.expect(Number.isInteger(json.orderId), 'orderId phải là integer').to.be.true;",
              "    pm.expect(json.orderId).to.be.at.least(1);",
              "});",
              "",
              "if (json.orderId) {",
              "    pm.environment.set('orderId', json.orderId);",
              "    console.log('[HW06][SETUP-04] orderId =', json.orderId, '(state = pending)');",
              "}",
              "",
              "pm.test('SETUP-04 · đã set environment {{orderId}}', function () {",
              "    pm.expect(pm.environment.get('orderId'), 'orderId').to.not.be.empty;",
              "});",
              "",
              "pm.test('SETUP-04 · response time < 2000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
