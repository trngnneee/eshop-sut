    {
      "name": "CI-FAIL — BUG-05 shipping→cancel (expect 400)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "id": "ci-fail-pre",
            "type": "text/javascript",
            "exec": [
              "// Dựng đơn tới state 'shipping' rồi để request chính cancel (expect 400 = contract FR-10).",
              "const base = pm.environment.get('baseUrl');",
              "const sid  = pm.environment.get('studentId');",
              "const uTok = pm.environment.get('userToken');",
              "const aTok = pm.environment.get('adminToken');",
              "function hdr(t){ const h={'Content-Type':'application/json','X-Student-Id':sid}; if(t) h['Authorization']='Bearer '+t; return h; }",
              "pm.sendRequest({ url: base+'/api/checkout', method:'POST', header:hdr(uTok),",
              "  body:{mode:'raw',raw:JSON.stringify({total_amount:200000, shipping_address:'CI shipping'})}},",
              "  function(e,r){",
              "    const id = r.json().orderId; pm.environment.set('ciShipOrderId', id);",
              "    pm.sendRequest({ url: base+'/api/admin/orders/'+id+'/status', method:'PUT', header:hdr(aTok),",
              "      body:{mode:'raw',raw:JSON.stringify({status:'confirmed'})}}, function(){",
              "        pm.sendRequest({ url: base+'/api/admin/orders/'+id+'/status', method:'PUT', header:hdr(aTok),",
              "          body:{mode:'raw',raw:JSON.stringify({status:'shipping'})}}, function(){});",
              "      });",
              "  });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "id": "ci-fail-test",
            "type": "text/javascript",
            "exec": [
              "// CONTRACT FR-10: user KHÔNG được hủy đơn đang shipping ⇒ expect 400.",
              "// SUT trả 200 (BUG-05) ⇒ đúng 1 assertion FAIL — pipeline đỏ có chủ đích.",
              "pm.test('BUG-05 · shipping -> cancel phải 400 (SUT trả 200 ⇒ FAIL)', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ],
