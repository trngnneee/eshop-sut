{
  "info": {
    "_postman_id": "mini-products-23127207",
    "name": "Mini API Testing - POST /api/products",
    "description": "Data-driven contract and functional tests for the selected API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "apiPath",
      "value": "/api/products",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "POST create product - data driven",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{{bodyJson}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}{{apiPath}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Creates a product using the request body from the current iteration."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({",
              "  key: \"X-Student-Id\",",
              "  value: pm.environment.get(\"studentId\"),",
              "});",
              "",
              "pm.request.headers.upsert({",
              "  key: \"Content-Type\",",
              "  value: pm.iterationData.get(\"content_type\") || \"application/json\",",
              "});",
              "pm.variables.set(\"bodyJson\", JSON.stringify(pm.iterationData.get(\"body\")));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expected = Number(pm.iterationData.get(\"expected_status\"));",
              "const tc = pm.iterationData.get(\"tc_id\");",
              "const expectId = String(pm.iterationData.get(\"expect_id\")).toLowerCase() === \"true\";",
              "",
              "pm.test(`Functional: ${tc} returns expected status`, () => {",
              "  pm.response.to.have.status(expected);",
              "});",
              "",
              "pm.test(`[MINI] ${tc} response time < 1000ms`, () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "if (expectId) {",
              "  const schema = {",
              "    type: \"object\",",
              "    required: [\"message\", \"id\"],",
              "    properties: {",
              "      message: { type: \"string\" },",
              "      id: { type: \"number\" }",
              "    }",
              "  };",
              "",
              "  pm.test(`Contract: ${tc} response matches {message,id} schema`, () => {",
              "    pm.response.to.have.jsonSchema(schema);",
              "  });",
              "",
              "  pm.collectionVariables.set(\"createdProductId\", String(pm.response.json().id));",
              "}",
              "",
              "if (expected >= 200 && expected < 300) {",
              "  pm.test(`[MINI] ${tc} Content-Type is application/json`, () => {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "  });",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
